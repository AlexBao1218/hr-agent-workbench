# Server-side only. Never commit real credentials.
HR_ACCESS_USER=hr
HR_ACCESS_PASSWORD=
HR_DATA_DIR=/data
HR_STORAGE_BACKEND=local
# For Render Free use supabase after SQL bootstrap and private bucket creation.
# HR_STORAGE_BACKEND=supabase
# HR_DATABASE_URL=postgresql://USER:PASSWORD@SESSION_POOLER:5432/postgres?sslmode=require
# HR_SUPABASE_URL=https://PROJECT.supabase.co
# HR_SUPABASE_SECRET_KEY=
# HR_STORAGE_BUCKET=hr-ai-private
# HR_CACHE_DIR=/tmp/hr-ai
HR_FRONTEND_DIST=/app/frontend/dist
# Set to the final HTTPS website origin, e.g. https://your-app.onrender.com
HR_ALLOWED_ORIGINS=
HR_MODEL_MODE=live
HR_MODEL_PROVIDER=deepseek
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=
HR_MODEL_REASONING_EFFORT=none
HR_MAX_REPAIRS=1
HR_MODEL_MAX_CALLS=50
HR_MODEL_MAX_OUTPUT_TOKENS=12000
HR_MODEL_MAX_INPUT_BYTES=150000
HR_MODEL_TIMEOUT_SECONDS=300
# Opt in to Flash draft + ordinary Kimi K3.1 Pro synthesis. Set these in Render,
# never in source control. On first start, active roles are versioned while the draft is preserved.
# HR_JOINT_ANALYSIS=1
# MOONSHOT_API_KEY=
# HR_MODEL_MAX_OUTPUT_TOKENS=32768
# HR_MODEL_TIMEOUT_SECONDS=600
